# Chaves de API opcionais para enriquecimento do catálogo de filmes.
# Ambas são opcionais: sem nenhuma chave configurada, o CineFood utiliza
# automaticamente o catálogo público gratuito (iTunes Search + acervo local curado)
# e exibe notas curadas nos filmes demo ou "N/D" quando indisponíveis.

# Chave da API TMDB v3 (https://www.themoviedb.org/settings/api)
# Habilita catálogo extenso paginado, busca por gênero em pt-BR e IDs externos.
VITE_TMDB_API_KEY=

# Chave da API OMDb (https://www.omdbapi.com/apikey.aspx)
# Habilita consulta sob demanda das notas de IMDb e Rotten Tomatoes.
VITE_OMDB_API_KEY=
